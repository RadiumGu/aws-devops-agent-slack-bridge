# ============================================================================
# DevOps Agent demo — environment variables
# ============================================================================
# Copy this file to .env (NOT committed) and fill in the secrets.
#   cp .env.example .env
#   # edit .env
#   ./scripts/deploy.sh
#
# How to get each value:
#   AWS_ACCOUNT_ID         — `aws sts get-caller-identity --query Account --output text`
#   AWS_REGION             — your target region (this project assumes one region)
#   DEVOPS_AGENT_SPACE_ID  — Console: aidevops → Agent Spaces → pick space →
#                            Copy ARN; the UUID after "agentspace/" is the ID
#   DEVOPS_AGENT_SPACE_ARN — same Copy ARN value, full ARN
#   SLACK_CHANNEL          — Slack: right-click channel → View channel details
#                            → bottom of "About" tab shows Channel ID (Cxxxxxx)
#   SLACK_WEBHOOK_URL      — Slack App → Incoming Webhooks → Add New Webhook
#                            (only needed once; deploy.sh writes it to Secrets
#                             Manager and Lambda-B reads from there at runtime)
#   SLACK_BOT_TOKEN_*      — for chatbot only; see docs/slack-setup.md
#   API_GATEWAY_INVOKE_URL — leave blank initially; deploy-chatbot.sh prints
#                            this after the first run, paste it back here
# ============================================================================

# ---- AWS account + region ----
AWS_ACCOUNT_ID=<your-12-digit-account-id>
AWS_REGION=<your-region>

# ---- DevOps Agent Space ----
# Get from console: aidevops -> Agent Spaces -> click space -> "Copy ARN"
# The UUID after "agentspace/" is the agent_space_id.
DEVOPS_AGENT_SPACE_ID=<your-agent-space-uuid>
DEVOPS_AGENT_SPACE_ARN=arn:aws:aidevops:<region>:<account-id>:agentspace/<uuid>

# ---- Slack notification ----
# Channel ID where alarm summaries land, plus the Incoming Webhook URL bound
# to that channel. The webhook URL is only used by deploy.sh to seed/rotate
# the Secrets Manager secret — Lambda-B reads from Secrets Manager at runtime
# and never sees this plaintext value.
# To rotate: update SLACK_WEBHOOK_URL here, re-run scripts/deploy.sh
# (or use `aws secretsmanager put-secret-value`), then trigger a Lambda
# config update so warm containers cycle.
SLACK_CHANNEL=<your-slack-channel-id>
SLACK_WEBHOOK_URL=<redacted-paste-from-1password>
SLACK_WEBHOOK_SECRET_NAME=devops-agent/slack-webhook-url

# ---- Resource names (rarely need to change) ----
ROLE_NAME=DevOpsAgentDemoLambdaRole
LAMBDA_A_NAME=devops-agent-trigger-investigation
LAMBDA_B_NAME=devops-agent-notify-slack
LAMBDA_C_NAME=devops-agent-slack-chatbot
LAYER_NAME=boto3-latest
RULE_1_NAME=DevOps-Agent-Demo-Alarm-To-Lambda
RULE_2_NAME=DevOps-Agent-Investigation-Completed
API_NAME=devops-agent-slack-chatbot-api

# ---- Slack Chatbot (multi-turn @mention) ----
# Bot Token (xoxb-...) for chat.postMessage
SLACK_BOT_TOKEN_SECRET_ID=devops-agent/slack-chatbot-token
# App-level signing secret for verifying inbound Slack signatures
SLACK_SIGNING_SECRET_ID=devops-agent/slack-signing-secret
# Channel where the bot is invited and tested
SLACK_TEST_CHANNEL=<your-slack-channel-id>
# DDB table for thread_ts → executionId mapping (multi-turn state)
THREAD_TABLE_NAME=devops-agent-slack-threads

# ---- API Gateway invoke URL (filled after first chatbot deploy) ----
# scripts/deploy-chatbot.sh prints this URL when it finishes. Paste it back
# here so subsequent reruns / docs / sanity checks have one source of truth.
API_GATEWAY_INVOKE_URL=<filled-after-first-deploy>

# ---- boto3 version ----
# DevOps Agent client requires boto3 >= 1.43.0.
# Lambda runtime python3.12 ships an older boto3, so we bundle a fresh one
# in the Lambda layer. The deploy script does this automatically.
BOTO3_MIN_VERSION=1.43.0
